[Unit]
Description=ratelimit TCP/UDP rate-limiting proxy
Documentation=man:ratelimit(1) https://github.com/manalejandro/ratelimit
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/ratelimit --config /etc/ratelimit/ratelimit.conf
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=2
LimitNOFILE=65536

# Needs to bind low ports but nothing else privileged.
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE

# Sandboxing. MemoryDenyWriteExecute is intentionally NOT set:
# hostname resolution may dlopen NSS modules.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=multi-user.target
